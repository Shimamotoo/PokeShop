# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/pokeshop?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pokeshop_test?schema=public"

# API & Servidor
PORT=3334
API_URL="http://localhost:3334"
WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3334"

# JWT Autenticação
JWT_SECRET="super-secret-jwt-key-change-in-production"

# AWS S3 (Bucket Privado para Fotos)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="sua-access-key-id"
AWS_SECRET_ACCESS_KEY="sua-secret-access-key"
AWS_S3_BUCKET_NAME="pokeshop-media-private"

# Google OAuth
GOOGLE_CLIENT_ID="seu-google-client-id"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"
